# Sentinel.io Analytics API base URL — must include the /api/v1 prefix.
# Read in web/src/lib/api/client.ts. Copy this file to .env.local (gitignored)
# and adjust for your environment.

# Local development (default the app falls back to if this var is unset):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Production (Vercel) — set NEXT_PUBLIC_API_BASE_URL to this value in the
# Vercel project's Environment Variables *before* triggering a build. Next.js
# inlines NEXT_PUBLIC_* vars into the client bundle at build time, so setting
# it after the app is already built/deployed has no effect.
# NEXT_PUBLIC_API_BASE_URL=https://sentinel-api-sjie.onrender.com/api/v1
